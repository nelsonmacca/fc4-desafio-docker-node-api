# Copie para .env: `cp .env.example .env` (ou Copy-Item no PowerShell).
# Somente credenciais de desenvolvimento local. Nunca use estes valores em producao.

# Porta em que a API escuta no container e e publicada no host (http://localhost:PORT)
PORT=3000

# Conexao com o PostgreSQL.
# DB_HOST e o nome do servico `db` declarado no compose.yaml (resolvido pela network).
DB_HOST=db
DB_PORT=5432
DB_USER=flags
DB_PASSWORD=flags_dev_password
DB_NAME=flags
